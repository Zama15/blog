---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_AUTHOR,
  SITE_KEYWORDS,
} from "../lib/constants";

import "../styles/main.scss";

interface Props {
  title: string;
  description: string;
  keywords: string;
  author?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  keywords = SITE_KEYWORDS,
  author = SITE_AUTHOR,
  image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      keywords={keywords}
      author={author}
      image={image}
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
