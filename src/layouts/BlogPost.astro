---
import BaseLayout from "./BaseLayout.astro";
import PostSidebar from "../components/PostSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";

import { ROUTES, SITE_AUTHOR } from "../lib/constants";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  keywords: string;
  draft: boolean;
  headings: MarkdownHeading[];
}

const { title, description, date, tags, keywords, draft, headings } =
  Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  type="article"
  publishedTime={date}
  tags={tags}
>
  <div class="container">
    <div class="row">
      <main class="col-lg-8">
        <article>
          <header>
            {draft && <mark>DRAFT CONTENT</mark>}

            <h1>{title}</h1>

            <p class="text-muted">
              <time datetime={date.toISOString()}>
                {date.toDateString()}
              </time>
              {" · by "}
              <a href={ROUTES.ABOUT} rel="author">{SITE_AUTHOR}</a>
            </p>

            <hr />
          </header>

          <TableOfContents headings={headings} />

          <slot />

          <footer class="mt-4">
            <ul class="list-inline">
              {
                tags.map((tag) => (
                  <li class="list-inline-item pe-3">
                    <a href={`${ROUTES.TAGS}/${tag}`}>#{tag}</a>
                  </li>
                ))
              }
            </ul>
          </footer>
        </article>
      </main>

      <PostSidebar />
    </div>
  </div>
</BaseLayout>
