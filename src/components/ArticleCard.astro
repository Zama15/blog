---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"learnings">;
}

const { post } = Astro.props;
const { slug, title, description, date, tags, draft } = post.data;
---

<article>
  <header class="row">
    <h2 class="col-12 col-md-8 h5">
      {draft && <mark class="me-2">DRAFT</mark>}
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>

    <nav class="col-12 col-md-4 p-0 navbar navbar-expand">
      <ul class="navbar-nav ms-auto">
        {
          tags.map((tag) => (
            <li class="nav-item ps-3">
              <a href={`/tags/${tag}`}>#{tag}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <p class="mb-0 text-secondary">{description}</p>

  <footer class="text-muted small">
    <time datetime={date.toISOString()}>
      {date.toDateString()}
    </time>
  </footer>
</article>
