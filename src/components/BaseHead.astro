---
import { ROUTES, SITE_OG_IMAGE, SITE_TITLE } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  keywords: string;
  author: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
}

const faviconVersion = "1.2.0";

const {
  title,
  description,
  keywords,
  author,
  image = SITE_OG_IMAGE,
  noindex = false,
  type = "website",
  publishedTime,
  tags = [],
} = Astro.props;

// One public URL per page: no trailing slash, except the home page.
const pathname = Astro.url.pathname;
const canonicalPath =
  pathname.length > 1 ? pathname.replace(/\/+$/, "") : pathname;
const canonicalURL = new URL(canonicalPath, Astro.site);
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const ogImage = new URL(image, Astro.url);
const siteUrl = Astro.site;
const authorURL = new URL(ROUTES.ABOUT, Astro.site);

const isArticle = type === "article" && publishedTime !== undefined;
const publishedISO = publishedTime?.toISOString();

const person = {
  "@type": "Person",
  name: author,
  url: siteUrl,
  sameAs: ["https://github.com/zama15", "https://linkedin.com/in/zama15"],
};

// Posts describe themselves as articles; every other page describes the site owner.
const structuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description: description,
      image: ogImage.toString(),
      datePublished: publishedISO,
      author: { ...person, url: authorURL },
      keywords: tags,
      url: canonicalURL,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
      inLanguage: "en",
    }
  : {
      "@context": "https://schema.org",
      ...person,
      image: ogImage.toString(),
      description: description,
      jobTitle: "Developer",
    };

// Escape "<" so text from posts can never close the script element.
const structuredDataJSON = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<!-- ===== CRITICAL METADATA ===== -->
<meta charset="utf-8" />
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>
<meta name="description" content={description} />
<meta name="title" content={title} />
<meta name="generator" content={Astro.generator} />

<!-- ===== SEO & INDEXING ===== -->
<meta name="robots" content={robots} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="keywords" content={keywords} />
<meta name="author" content={author} />

<!-- Language & Localization -->
<meta name="language" content="en" />

<!-- ===== THEME & BRANDING ===== -->
<meta
  name="theme-color"
  content="#ffffff"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#212529"
  media="(prefers-color-scheme: dark)"
/>
<meta name="color-scheme" content="light dark" />
<meta name="apple-mobile-web-app-title" content="Zama15 Blog" />
<meta name="application-name" content="Zama15 Blog" />

<!-- ===== FAVICONS ===== -->
<!-- Modern SVG favicon with theme support (primary) -->
<link
  rel="icon"
  type="image/svg+xml"
  href={`/favicon.svg?v=${faviconVersion}`}
/>

<!-- PNG fallback for specific sizes -->
<link
  rel="icon"
  type="image/png"
  sizes="96x96"
  href={`/favicon-96x96.png?v=${faviconVersion}`}
/>

<!-- Legacy browsers -->
<link rel="shortcut icon" href={`/favicon.ico?v=${faviconVersion}`} />

<!-- Apple devices -->
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href={`/apple-touch-icon.png?v=${faviconVersion}`}
/>

<!-- Safari pinned tab (minimal design) -->
<link
  rel="mask-icon"
  href={`/favicon.svg?v=${faviconVersion}`}
  color="#212529"
/>

<!-- ===== WEB APP & PWA ===== -->
<link rel="manifest" href={`/site.webmanifest?v=${faviconVersion}`} />

<!-- ===== FEED ===== -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={ROUTES.RSS}
/>

<!-- ===== CANONICAL ===== -->
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- ===== SOCIAL & OG TAGS ===== -->
<meta property="og:type" content={isArticle ? "article" : "website"} />
{
  isArticle && (
    <>
      <meta property="article:published_time" content={publishedISO} />
      <meta property="article:author" content={authorURL} />
      {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )
}
{!noindex && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="Zama15 Blog" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
{!noindex && <meta name="twitter:url" content={canonicalURL} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- ===== STRUCTURED DATA (JSON-LD) ===== -->
<script type="application/ld+json" set:html={structuredDataJSON} />

<!-- ===== PRECONNECT & DNS-PREFETCH (Performance) ===== -->
<!-- Add external services -->
<!-- <link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="dns-prefetch" href="https://cdn.example.com" /> -->

<!-- ===== TITLE ===== -->
<title>{title}</title>
