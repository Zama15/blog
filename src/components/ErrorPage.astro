---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  code: string;
  title: string;
  message: string;
  showTrace?: boolean;
}

const { code, title, message, showTrace = false } = Astro.props;
---

<BaseLayout title={`${code} - ${title} | Zama15`}>
  <main
    class="container min-vh-75 d-flex flex-column align-items-center justify-content-center text-center"
  >
    <h1>{code}</h1>

    <h2 class="mt-3">{title}</h2>

    <p class="col-md-8 col-lg-6 text-muted mt-2 mb-4">
      {message}
    </p>

    <a href="/">Return Home</a>

    {
      showTrace && (
        <code class="col-12 col-md-10 col-lg-8 my-5 p-2 text-start border rounded-0">
          <slot />{" "}
        </code>
      )
    }
  </main>
</BaseLayout>
