---
import BaseLayout from "../layouts/BaseLayout.astro";

import { ROUTES } from "../lib/constants";

interface Props {
  code: string;
  title: string;
  message: string;
  showTrace?: boolean;
}

const { code, title: errorTitle, message, showTrace = false } = Astro.props;

const title = `Error ${code}: ${errorTitle} | Zama15 Blog`;
const description = `Error ${code}: ${errorTitle}. You've hit a snag on the blog. Return to the home page to discover other learnings.`;
const keywords = `error ${code},${errorTitle}, Zama15 blog, development tutorials, site error code`;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <main
    class="container min-vh-75 d-flex flex-column align-items-center justify-content-center text-center"
  >
    <h1>{code}</h1>

    <h2 class="mt-3">{errorTitle}</h2>

    <p class="col-md-8 col-lg-6 text-muted mt-2 mb-4">
      {message}
    </p>

    <a href={ROUTES.HOME}>Return Home</a>

    {
      showTrace && (
        <code class="col-12 col-md-10 col-lg-8 my-5 p-2 text-start border rounded-0">
          <slot />{" "}
        </code>
      )
    }
  </main>
</BaseLayout>
