---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";

const learnings = await getCollection("learnings");
const visibleLearnings = learnings.filter(
  (post) => !post.data.draft || import.meta.env.DEV,
);
visibleLearnings.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <main>
    <header>
      <h1>All Posts</h1>

      <nav>
        <a href="/tags">Explore Tags</a>
      </nav>
    </header>

    <ul>
      {
        visibleLearnings.map((post) => (
          <li>
            {post.data.draft && <mark>DRAFT</mark>}

            <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>

            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString()}
            </time>

            <ul>
              {post.data.tags.map((tag) => (
                <li>
                  <a href={`/tags/${tag}`}>#{tag}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
