---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Blog Statistics";
const description =
  "View statistics for blog, including total posts, topics covered, and recent update timestamps. Data fetched dynamically via API.";
const keywords =
  "blog stats, blog statistics, live post count, blog topics data, dynamic blog data, api driven statistics";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <main class="container">
    <div class="row">
      <img
        src="/api/stats"
        alt="Real-time Blog Statistics including total posts, topics, and last update time."
        class="col-12 col-md-6 mx-auto"
      />
      <p class="col-12 mt-3 text-center text-muted small">
        Live data fetched from <a href="/api/stats" target="_blank"
          >/api/stats</a
        >
      </p>
    </div>
  </main>
</BaseLayout>
