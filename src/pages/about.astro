---
import BaseLayout from "../layouts/BaseLayout.astro";

import { ROUTES } from "../lib/constants";

const timeline = [
  {
    role: "Developer Jr",
    organization: "EVCON Energy",
    dates: "August 2026 - Present",
    description:
      "Developing EV charging app, energy management platform, and internal tools with React, NestJS, AWS.",
  },
  {
    role: "Developer Intern",
    organization: "EVCON Energy",
    dates: "February 2026 - July 2026",
    description:
      "Built error-handling modules, serverless migration, IAM permissions, and dual-write provisioning with NestJS and AWS.",
  },
  {
    role: "Web Development Certification",
    organization: "BrightCoders",
    dates: "November 2023 - May 2024",
    description:
      "Intensive certification covering Ruby, version control, and professional soft skills for web development.",
  },
  {
    role: "Software Engineering Student",
    organization: "Universidad de Colima",
    dates: "August 2022 - June 2026",
    description:
      "Studying software architecture, databases, algorithms, and systems engineering with hands-on capstone projects.",
  },
];

const projects = [
  {
    title: "University of Colima Repository",
    description:
      "Layered architecture (Domain/Application/Infrastructure) with PostgreSQL and Prisma ORM, using migrations and transactions for data consistency.",
    tags: ["Backend", "Architecture", "PostgreSQL"],
    url: "https://github.com/ReUC-Team/ReUC",
  },
  {
    title: "Augmented Reality Game",
    description:
      "Educational AR app for high school students using Unity, Vuforia tracking, and Firebase Auth for adaptive learning.",
    tags: ["Unity", "AR/Vuforia", "C#"],
    url: "https://github.com/Quimex-AR/Quimex-AR",
  },
  {
    title: "Android SPA Mobile Application",
    description:
      "Spa booking prototype built with Kotlin, MVVM architecture, and Google Maps for location and scheduling features.",
    tags: ["Kotlin", "MVVM", "Mobile"],
    url: "https://github.com/WolfkarlX/SpaTi",
  },
  {
    title: "Custom PHP Framework",
    description:
      "Rails-inspired MVC framework in vanilla PHP, powering a forum with a custom ORM and query builder.",
    tags: ["PHP", "MVC", "Custom ORM"],
    url: "https://github.com/AngelDiaz591/PI4_Foro_Web",
  },
];

const title = "Alejandro Jeronimo Azamar | Software Engineer Portfolio";
const description =
  "Explore the portfolio and career trajectory of Alejandro Jeronimo Azamar (Zama), a Software Engineer specializing in backend architecture, web development, and cloud solutions.";
const keywords =
  "Alejandro Jeronimo Azamar, Zama, Software Engineer, Web Developer, Backend Development, NestJS, React, AWS, PostgreSQL, Portfolio, Tech Trajectory, Colima";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <main class="container">
    <header class="d-flex py-5">
      <div class="m-auto">
        <h1 class="mb-0 mb-2 mb-sm-0">Alejandro Jeronimo Azamar</h1>

        <div
          class="d-flex flex-column flex-sm-row justify-content-sm-between align-items-sm-center"
        >
          <a
            href={ROUTES.ABOUT_RESUME}
            target="_blank"
            rel="noopener noreferrer"
            class="small mb-2 mb-sm-0"
            aria-label="View and download my Resume in PDF format"
          >
            View Resume
            <i class="bi bi-file-earmark-pdf ms-1"></i>
          </a>

          <p class="font-monospace mb-0">Software Engineer</p>
        </div>
      </div>
    </header>

    <section class="py-5">
      <h2>Trajectory</h2>
      <hr />

      <ol class="timeline list-unstyled ms-2">
        {
          timeline.map((item) => (
            <li class="timeline-item position-relative ps-4 ps-md-5 pb-5 border-start">
              <article class="row">
                <div class="col-md-4 col-lg-3 mb-3 mb-md-0">
                  <p class="small mb-0">
                    <time class="d-block fw-medium">{item.dates}</time>
                    <span class="text-muted">{item.organization}</span>
                  </p>
                </div>

                <div class="col-md-8 col-lg-7">
                  <header>
                    <h3>{item.role}</h3>
                  </header>
                  <p class="mb-0">{item.description}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="py-5">
      <h2>Featured Work</h2>

      <hr />

      <ul class="row g-4 list-unstyled">
        {
          projects.map((project) => (
            <li class="col-md-6 col-lg-4">
              <article class="h-100 border rounded p-4">
                <header class="mb-3">
                  <h3>{project.title}</h3>
                </header>

                {/* Placeholder // Image Example*/}
                {/* <div
                  class="bg-light rounded mb-3 w-100"
                  style="aspect-ratio: 16/9;"
                /> */}
                {/* <img
                  src=""
                  alt=""
                  class="img-fluid mb-3"
                  style="aspect-ratio: 16/9;"
                /> */}

                <p class="small text-muted mb-4 flex-grow-1">
                  {project.description}
                </p>

                <ul class="list-unstyled d-flex flex-wrap gap-2 mb-3">
                  {project.tags.map((tag) => (
                    <li class="badge border text-secondary py-1 px-2">{tag}</li>
                  ))}
                </ul>

                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="small"
                  aria-label={`View ${project.title} source code on GitHub`}
                >
                  View on GitHub
                  <i class="bi bi-box-arrow-up-right ms-1" />
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="py-5">
      <h2>About Me</h2>

      <hr />

      <p class="lead mb-4">
        I am Alejandro Jeronimo Azamar, though I usually go by Zama—a shortened
        version of my last name.
      </p>

      <article>
        <h3>The Learning Process</h3>
        <p class="text-muted mb-0">
          I often spend hours researching, thinking, "Maybe this could be
          improved?" or "I should double-check this..." This curiosity leads me
          to deepen my knowledge, learn new things, and bring out the best in my
          work.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>
