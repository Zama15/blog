---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

import { ROUTES } from "../../lib/constants";
import { getAllTags, getPostsByTag } from "../../lib/data";

export async function getStaticPaths() {
  const tags = await getAllTags();

  return Promise.all(
    tags.map(async (tag) => {
      const posts = await getPostsByTag(tag);
      return {
        params: { tag },
        props: { posts },
      };
    }),
  );
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const title = `Explore #${tag} Posts`;
const description = `Explore technical learnings and in-depth blog posts about ${tag}. Discover hands-on tutorials, developer insights, and coding tips.`;
const keywords = `${tag} tutorials, learn ${tag}, ${tag} technical articles, ${tag} developer tips, tech blog ${tag}, coding learnings, software development`;
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <main class="container">
    <h1><code>#{tag}</code> Posts</h1>
    <hr />

    <nav class="navbar navbar-expand">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item ps-3">
          <a href={ROUTES.TAGS}>Explore by tags</a>
        </li>
        <li class="nav-item ps-3">
          <a href={ROUTES.BLOG_DAILY}> Random Post </a>
        </li>
      </ul>
    </nav>

    <ul class="navbar-nav w-100">
      {
        posts.map((post) => (
          <li class="nav-item p-2 mb-4">
            <ArticleCard post={post} />
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
