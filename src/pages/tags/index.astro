---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { getCollection } from "astro:content";

const learnings = await getCollection("learnings");
const visibleLearnings = learnings.filter(
  (post) => !post.data.draft || import.meta.env.DEV,
);
visibleLearnings.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Logic:
// 1. Make an array of all the tags array.
// 2. Flatten the array of arrays into one big list of tags.
// 3. Create a 'Set' to remove duplicates.
// 4. Convert back to an array.
const tags = [
  ...new Set(visibleLearnings.map((post) => post.data.tags).flat()),
];
---

<BaseLayout>
  <main>
    <header>
      <h1>Tags</h1>
    </header>

    <ul>
      {
        tags.map((tag) => (
          <li>
            <a href={`/tags/${tag}`}>#{tag}</a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
